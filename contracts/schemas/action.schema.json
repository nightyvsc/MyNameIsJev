{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.schema.json",
  "title": "Action",
  "description": "Acción sintética interceptada antes de ejecutarse.",
  "type": "object",
  "required": ["schema_version", "action_id", "action_class", "tool", "actor", "args", "recipients", "payload", "risk_level", "dry_run", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0" },
    "action_id": { "type": "string", "format": "uuid" },
    "action_class": { "enum": ["email_bulk", "crm_write", "social_post", "pr_action"] },
    "subtype": { "enum": ["merge", "approve", "push_main", "touch_ci", "touch_secrets", "add_dependency", "delete_files"] },
    "tool": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "args": { "type": "object" },
    "recipients": { "type": "array", "items": { "type": "string" } },
    "payload": { "type": "object", "description": "Contenido sintético que evaluará JEV." },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "dry_run": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "action_class": { "const": "pr_action" } }, "required": ["action_class"] },
      "then": { "required": ["subtype"] },
      "else": { "not": { "required": ["subtype"] } }
    }
  ]
}
