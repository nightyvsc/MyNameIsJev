{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "Decision",
  "description": "Resultado del gate; pending representa do-nothing mientras JEV no responde.",
  "type": "object",
  "required": ["schema_version", "action_id", "status", "reasons", "features", "jev_answers", "source", "latency_ms", "cost_usd", "decided_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0" },
    "action_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["pending", "decided", "expired"] },
    "verdict": { "enum": ["allow", "ask", "deny"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "features": { "type": "object", "description": "Hechos calculados determinísticamente, por ejemplo recipient_count, records_count, changed_files, pii_matches." },
    "jev_answers": {
      "type": "object",
      "description": "question_id -> respuesta tipada con probabilidades por etiqueta.",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "probs"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["boolean", "choice", "score"] },
          "probs": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
        }
      }
    },
    "source": { "enum": ["jev", "mock"] },
    "latency_ms": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "decided_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "decided" } }, "required": ["status"] }, "then": { "required": ["verdict"] }, "else": { "not": { "required": ["verdict"] } } }
  ]
}
