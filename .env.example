# Environment — copy this to .env and fill in values
# DO NOT commit .env to version control

# ── JEV API ──────────────────────────────────────────────────────────────────
TYPESAFE_API_KEY=your_jev_api_key_here
JEV_MODEL=jev-1.14
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT_SECONDS=10
JEV_MAX_RETRIES=2

# ── Gateway ───────────────────────────────────────────────────────────────────
GATE_TOKEN=changeme-dev-token
GATE_HOST=0.0.0.0
GATE_PORT=8000
CONFIG_PATH=config/thresholds.yaml
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./audit.db
# For production: postgresql+asyncpg://user:pass@vm5.local:5432/jev_gate

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── GitHub Integration ────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
