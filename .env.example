# Local deployment values template.
# Copy to .env and replace secrets locally. Never commit the populated file.
# Do not copy this all-in-one file to a VM; create a least-privilege per-host .env.

# Private VM addresses are intentionally supplied in the ignored local .env, not here.
VM1_IP=<VM1_PRIVATE_IP>
VM2_IP=<VM2_PRIVATE_IP>
VM3_IP=<VM3_PRIVATE_IP>
VM4_IP=<VM4_PRIVATE_IP>
VM5_IP=<VM5_PRIVATE_IP>
VM6_IP=<VM6_PRIVATE_IP>
SSH_USER=estudiante

# Gateway on VM1. Create a separate, owner-readable .env on each destination VM.
VM1_BIND_IP=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_BASE_URL=http://<VM1_PRIVATE_IP>:8000
GATE_TOKEN=
JEV_GATE_DB=/var/lib/jev-gate/audit.sqlite3
JEV_GATE_POLICY=/app/docs/policy.defaults.json
JEV_GATE_QUESTIONS=/app/docs/jev_questions.json

# TypeSafe credentials belong only in VM1's restricted .env.
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# VM2: Streamlit dashboard. It uses the gateway API, never the SQLite file.
VM2_BIND_IP=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_APPROVER_ID=dashboard-operator

# VM3: simulated world APIs, all private to the VM network.
VM3_BIND_IP=127.0.0.1
CRM_PORT=3001
MAIL_REST_PORT=3002
MAIL_SMTP_PORT=2525
SOCIAL_PORT=3003
GITHUB_RELAY_PORT=3004
CRM_BASE_URL=http://<VM3_PRIVATE_IP>:3001
MAIL_REST_BASE_URL=http://<VM3_PRIVATE_IP>:3002
SOCIAL_BASE_URL=http://<VM3_PRIVATE_IP>:3003
GITHUB_RELAY_BASE_URL=http://<VM3_PRIVATE_IP>:3004

# VM4: agents. CRM, social, SMTP and gateway calls are separate destinations.
WORLD_BASE_URL=http://<VM3_PRIVATE_IP>:3001
MAIL_SMTP_HOST=<VM3_PRIVATE_IP>

# VM3 GitHub relay. Inbound webhook reachability from GitHub.com is not yet configured.
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_ENABLE_WRITES=false
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# VM5 stores verified, offline SQLite backup copies; it is not a live database node.
# scripts/backup_sqlite.py transfers to SSH alias vm5 at backups/mynameisjev.

# VM6 runs bounded load/CI work only; start load tests explicitly after baseline checks.
LOAD_TEST_TARGET=http://<VM1_PRIVATE_IP>:8000
LOAD_TEST_MAX_WORKERS=2
